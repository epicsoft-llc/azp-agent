#### 3.14 is the newest Python the Azure CLI supports
FROM python:3.14-alpine AS builder

RUN apk --no-cache add cargo \
                       gcc \
                       libffi-dev \
                       linux-headers \
                       make \
                       musl-dev \
                       openssl-dev

RUN python -m venv /opt/azure-cli \
 && /opt/azure-cli/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/azure-cli/bin/pip install --no-cache-dir azure-cli

FROM python:3.14-alpine

ARG IMAGE_TAG="local"
ARG BUILD_DATE="development"
LABEL org.label-schema.name="Azure Pipelines agent" \
      org.label-schema.description="Self-hosted Azure Pipelines agent with Azure CLI on Ubuntu and Alpine - amd64, arm64, rebuilt weekly" \
      org.label-schema.vendor="epicsoft LLC / Alexander Schwarz <info@epicsoft.one>" \
      org.label-schema.url="https://gitlab.com/epicsoft-networks/azp-agent" \
      org.label-schema.vcs-url="https://gitlab.com/epicsoft-networks/azp-agent/-/tree/main" \
      org.label-schema.version=${IMAGE_TAG} \
      org.label-schema.schema-version="1.0" \
      org.label-schema.build-date=${BUILD_DATE}

LABEL image.name="epicsoft_azp_agent" \
      image.description="Self-hosted Azure Pipelines agent with Azure CLI on Ubuntu and Alpine - amd64, arm64, rebuilt weekly" \
      maintainer="epicsoft LLC" \
      maintainer.name="Alexander Schwarz <info@epicsoft.one>" \
      maintainer.copyright="Copyright 2025-2026 epicsoft LLC / Alexander Schwarz" \
      license="MIT"

#### packages of the base image lag behind the Alpine repository - the upgrade brings their security fixes
RUN apk --no-cache upgrade \
 && apk --no-cache add bash \
                       ca-certificates \
                       curl \
                       git \
                       icu-libs \
                       jq \
                       libgcc \
                       libstdc++ \
 && adduser -D agent \
 && mkdir /azp \
 && chown agent:agent /azp

COPY --from=builder /opt/azure-cli /opt/azure-cli
RUN ln -s /opt/azure-cli/bin/az /usr/local/bin/az

COPY --chmod=755 start.sh platform.sh /azp/

WORKDIR /azp

USER agent

ENTRYPOINT [ "./start.sh" ]
