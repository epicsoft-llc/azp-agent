FROM python:3-alpine

ARG IMAGE_TAG="latest"
ARG BUILD_DATE="development"
LABEL org.label-schema.name="Azure pipelines agent" \
      org.label-schema.description="Docker image for Self-Hosted Azure pipelines agent" \
      org.label-schema.vendor="epicsoft LLC / Alexander Schwarz <as@epicsoft.one>" \
      org.label-schema.url="https://gitlab.com/epicsoft-networks/azure-devops-backup" \
      org.label-schema.vcs-url="https://gitlab.com/epicsoft-networks/azure-devops-backup/tree/main" \
      org.label-schema.version=${IMAGE_TAG} \
      org.label-schema.schema-version="1.0" \
      org.label-schema.build-date=${BUILD_DATE}

LABEL image.name="epicsoft_azp_agent" \
      image.description="Docker image for Self-Hosted Azure pipelines agent" \
      maintainer="epicsoft LLC" \
      maintainer.name="Alexander Schwarz <as@epicsoft.one>" \
      maintainer.url="https://epicsoft.one/"

ENV TARGETARCH="linux-musl-x64"

RUN apk update \
 && apk upgrade \
 && apk add bash \
            curl \
            gcc \
            git \
            icu-libs \
            jq \
            musl-dev \
            python3-dev \
            libffi-dev \
            openssl-dev \
            cargo \
            make \
            ca-certificates \
 && update-ca-certificates \
 && rm -rf /var/cache/apk/*

#### Install Azure CLI
RUN pip install --upgrade pip
RUN pip install azure-cli

WORKDIR /azp/

COPY ./start.sh ./
RUN chmod +x ./start.sh

RUN adduser -D agent
RUN chown agent ./

USER agent

#### Another option is to run the agent as root.
# ENV AGENT_ALLOW_RUNASROOT="true"

ENTRYPOINT [ "./start.sh" ]
